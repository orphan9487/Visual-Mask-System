# ============================================================
#  校內專題版 (thesis)  -  自製 WebSocket 聊天室,無 LINE / 無 talking face
#  用法:  copy .env.thesis.example .env   然後填入 DB 密碼即可
# ============================================================

# --- 變體開關(關鍵)-------------------------------------------
# thesis = 只跑自製聊天室,不載入 LINE webhook、talking face、TTS。
# 這樣就算沒安裝 line-bot-sdk、沒有 LINE 憑證也能啟動。
VMS_PROFILE=thesis

# --- 推論設定 --------------------------------------------------
# 1 = 關鍵字規則(不載入模型,先驗證管線)　0 = 真實 Breeze2 推理
VMS_MOCK=1
VMS_MODEL=breeze2-3b
VMS_QUANT=4bit

# Optional isolated emotion model service. Leave URL empty for in-process inference.
VMS_EMOTION_API_URL=
VMS_EMOTION_API_TOKEN=
VMS_EMOTION_API_TIMEOUT=120
VMS_EMOTION_API_FALLBACK=local

# --- 資料庫(密碼只寫在 .env,不要提交)-----------------------
VMS_DB_HOST=127.0.0.1
VMS_DB_PORT=3306
VMS_DB_USER=root
VMS_DB_PASSWORD=
VMS_DB_NAME=mcot_chat_db
