import os
import json

# 修改這裡指向你的 V2 資料集
dataset_dir = "./data/train_dataset_v2"
metadata_file = os.path.join(dataset_dir, "metadata.jsonl")

print(f"正在為 V2 資料集生成索引檔: {metadata_file}")

count = 0
with open(metadata_file, "w", encoding="utf-8") as f:
    for filename in os.listdir(dataset_dir):
        # 檢查是否為圖片
        if filename.lower().endswith((".png", ".jpg", ".jpeg")):
            base_name = os.path.splitext(filename)[0]
            txt_path = os.path.join(dataset_dir, f"{base_name}.txt")
            
            if os.path.exists(txt_path):
                with open(txt_path, "r", encoding="utf-8") as tf:
                    caption = tf.read().strip()
                
                # 寫入 JSONL 格式
                entry = {"file_name": filename, "text": caption}
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
                count += 1

if count > 0:
    print(f"✅ 完成！成功配對 {count} 組圖片與標籤。")
else:
    print(f"❌ 錯誤：在 {dataset_dir} 找不到任何成對的圖片與 .txt 檔，請檢查檔案名稱是否一致。")