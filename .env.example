# 複製本檔為 .env 後調整推論設定（.env 已被 .gitignore 排除，不會進版控）
#   copy .env.example .env

# 1 = 關鍵字規則(不載入模型，先驗證管線)　0 = 真實 Breeze2 推理
VMS_MOCK=1

VMS_MODEL=breeze2-3b
VMS_QUANT=4bit

# Optional isolated emotion model service. Leave URL empty for in-process inference.
VMS_EMOTION_API_URL=http://127.0.0.1:8010
VMS_EMOTION_API_TOKEN=
VMS_EMOTION_API_TIMEOUT=120
VMS_EMOTION_API_FALLBACK=local

# LoRA identity used by LINE image generation.
LINE_DEFAULT_MASK_ID=henry

# Optional Talking Face black-box service. The service accepts a face image
# and an audio file at POST /generate, then returns video/mp4 bytes.
VMS_TALKING_FACE_URL=http://127.0.0.1:8020
VMS_TALKING_FACE_TOKEN=
VMS_TALKING_FACE_TIMEOUT=300
VMS_TALKING_FACE_MAX_OUTPUT_MB=100
VMS_TALKING_FACE_ROOT=
VMS_TALKING_FACE_WORK_DIR=output/current/talking_face_sidecar
VMS_TALKING_FACE_MAX_INPUT_MB=25

# LINE text-to-speech and Talking Face orchestration.
LINE_TALKING_FACE_ENABLED=0
LINE_DELIVERY_MODE=push
LINE_REPLY_DEADLINE_SECONDS=50
VMS_TTS_VOICE=zh-TW-YunJheNeural
VMS_TTS_RATE=+0%
VMS_TTS_VOLUME=+0%
VMS_TTS_PITCH=+0Hz
VMS_TTS_TIMEOUT=60
VMS_TTS_MAX_TEXT_CHARS=500

# MySQL（正式密碼只寫在 .env，不要提交）
VMS_DB_HOST=127.0.0.1
VMS_DB_PORT=3306
VMS_DB_USER=root
VMS_DB_PASSWORD=
VMS_DB_NAME=mcot_chat_db
