# 複製本檔為 .env 後調整設定（.env 已被 .gitignore 排除，不會進版控）
#   copy .env.example .env

# --- 情緒推論 ---------------------------------------------------
# 1 = 關鍵字規則（不載入模型，先驗證管線）　0 = 真實模型推理
VMS_MOCK=0
VMS_MODEL=breeze2-3b
VMS_QUANT=fp16

# 選用：離線重訓的 ERC LoRA adapter 路徑；留空＝跑純底座。
# 必須與 VMS_MODEL 同一顆基座訓練（adapter 綁底座）。
VMS_LORA_PATH=

# 選用：把情緒模型獨立成 HTTP 服務時填其網址；留空＝在本行程內推理
VMS_EMOTION_API_URL=
VMS_EMOTION_API_TOKEN=
VMS_EMOTION_API_TIMEOUT=120
VMS_EMOTION_API_FALLBACK=local

# --- MySQL（正式密碼只寫在 .env，不要提交）---------------------
VMS_DB_HOST=127.0.0.1
VMS_DB_PORT=3306
VMS_DB_USER=root
VMS_DB_PASSWORD=
VMS_DB_NAME=mcot_chat_db
