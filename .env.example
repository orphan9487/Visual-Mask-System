# 複製本檔為 .env 後調整推論設定（.env 已被 .gitignore 排除，不會進版控）
#   copy .env.example .env

# 1 = 關鍵字規則(不載入模型，先驗證管線)　0 = 真實 Breeze2 推理
VMS_MOCK=0

VMS_MODEL=breeze2-3b
VMS_QUANT=4bit

# Isolated Breeze2 service. Start emotion_server.py before chat_server.py.
VMS_EMOTION_API_URL=http://127.0.0.1:8010
VMS_EMOTION_API_TOKEN=
VMS_EMOTION_API_TIMEOUT=120
# error prevents the main WebSocket process from loading an incompatible
# second copy of Breeze2 when the isolated service is unavailable.
VMS_EMOTION_API_FALLBACK=error

# LivePortrait runs in its own environment. Relative to project root.
VMS_LIVEPORTRAIT_ROOT=external/LivePortrait
# The current photo-mask pipeline uses LivePortrait only. Legacy image-backend
# and SD1.5 refinement variables do not enable diffusion in this version.

# MySQL（正式密碼只寫在 .env，不要提交）
VMS_DB_HOST=127.0.0.1
VMS_DB_PORT=3306
VMS_DB_USER=root
VMS_DB_PASSWORD=

# Browser login token signing key. Replace with a long random value before deployment.
VMS_SESSION_SECRET=change-this-to-a-long-random-secret
VMS_DB_NAME=mcot_chat_db
